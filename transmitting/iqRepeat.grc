options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Replay one prepared RFUAV clip through a USRP B210.


      The file must come from prepare_clip.py. A file source does not know the

      rate of its file, thus a source at 100 Msps that goes out at 10 Msps is 10

      times too slow and 10 times too narrow, and the replay is not the drone.


      Keep center_freq the same for every class. prepare_clip.py --offset-hz

      chooses which part of the source band arrives here.'
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: iqRepeat
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: IQ repeat
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [48, 20.0]
    rotation: 0
    state: enabled

blocks:
- name: center_freq
  id: variable
  parameters:
    comment: 'One value for the whole campaign, every class included. A centre

      frequency that follows the class is a perfect cue for the classifier.'
    value: '2440000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 32.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'The rate of the prepared file. Read it from the .json that

      prepare_clip.py wrote beside the .iq. It is not the rate of the source.'
    value: '10000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 28.0]
    rotation: 0
    state: enabled
- name: tx_gain
  id: variable
  parameters:
    comment: 'A fixed value, not a slider. The gain gives the signal-to-noise

      ratio of the whole session and nothing in the capture records it. A slider

      that somebody moved in the middle of a session spoils that session in

      silence. Write this number in the session notes.'
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 24.0]
    rotation: 0
    state: enabled
- name: tx_on
  id: variable
  parameters:
    comment: 'Set 0 to record the noise class. The USRP stays on, at the same

      frequency and the same gain, and it sends zeros. A noise class that is

      taken with the USRP off teaches the model to answer the question "is the

      USRP on".'
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 96.0]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: 'The output of prepare_clip.py, never the RFUAV source.


      repeat joins the end of the file to its start. The phase makes a step

      there, and the step is a wide transient once for each loop. Give every

      class clips of the same length, or the period of that transient becomes a

      class cue.'
    file: clips\pack1_1-2s.iq
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'True'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 176.0]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'The switch of the noise class.


      No throttle block is here, and that is deliberate. The USRP sink gives the

      rate of the flow graph. A throttle keeps its own time against the clock of

      the computer, thus the two move apart and the transmitter has an underrun.

      Use a throttle only when no hardware block is in the flow graph.'
    const: tx_on
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 220.0]
    rotation: 0
    state: enabled
- name: qtgui_waterfall_sink_x_0
  id: qtgui_waterfall_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '0'
    color10: '0'
    color2: '0'
    color3: '0'
    color4: '0'
    color5: '0'
    color6: '0'
    color7: '0'
    color8: '0'
    color9: '0'
    comment: ''
    fc: center_freq
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: ''
    int_max: '10'
    int_min: '-140'
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '""'
    nconnections: '1'
    showports: 'False'
    type: complex
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [656, 396.0]
    rotation: 0
    state: enabled
